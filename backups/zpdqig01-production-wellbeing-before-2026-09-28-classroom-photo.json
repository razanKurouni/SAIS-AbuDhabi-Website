  "sections": [
    {
      "_key": "commitment",
      "_type": "imageTextSection",
      "heading": {
        "_type": "sectionHeading",
        "description": [
          {
            "_key": "wc-lead",
            "_type": "block",
            "children": [
              {
                "_key": "wc-lead-s",
                "_type": "span",
                "marks": [
                  "strong"
                ],
                "text": "At Sharjah American International School – UAQ Campus (SAIS - UAQ), we are committed to nurturing the holistic well-being of both students and staff."
              }
            ],
            "markDefs": [],
            "style": "normal"
          },
          {
            "_key": "wc-p1",
            "_type": "block",
            "children": [
              {
                "_key": "wc-p1-s",
                "_type": "span",
                "marks": [],
                "text": "Our comprehensive Well-Being Framework rests on four pillars (emotional, social, mental, and physical health) and is woven into every aspect of school life, from classroom routines to campus-wide initiatives. Through these layered supports and proactive initiatives, SAIS - UAQ fosters an environment where every member of our community (students and staff alike) feels seen, supported, and empowered to thrive."
              }
            ],
            "markDefs": [],
            "style": "normal"
          }
        ],
        "title": "Our Commitment"
      },
      "image": {
        "_type": "image",
        "alt": "SAIS - UAQ students smiling in class",
        "asset": {
          "_ref": "image-38cc3aa2f8cd76ff8c050ed7fadda6f975e38d2f-3198x1454-jpg",
          "_type": "reference"
        }
      },
      "slot": "commitment"
    },
    {
      "_key": "counselingSupportSection",
      "_type": "imageTextSection",
      "heading": {
        "_type": "sectionHeading",
        "description": [
          {
            "_key": "cs-team",
            "_type": "block",
            "children": [
              {
                "_key": "cs-team-l",
                "_type": "span",
                "marks": [
                  "strong"
                ],
                "text": "Licensed Counseling Team:"
              },
              {
                "_key": "cs-team-t",
                "_type": "span",
                "marks": [],
                "text": "We employ a full-time school counselor and assistant counselors who provide individual check-ins, small-group workshops, and crisis intervention as needed."
              }
            ],
            "markDefs": [],
            "style": "normal"
          },
          {
            "_key": "cs-open-door",
            "_type": "block",
            "children": [
              {
                "_key": "cs-open-door-l",
                "_type": "span",
                "marks": [
                  "strong"
                ],
                "text": "Open-Door Policy:"
              },
              {
                "_key": "cs-open-door-t",
                "_type": "span",
                "marks": [],
                "text": "Every student and staff member may schedule drop-in sessions or refer peers, ensuring timely support for academic stress, interpersonal conflicts, or personal challenges."
              }
            ],
            "markDefs": [],
            "style": "normal"
          },
          {
            "_key": "cs-outreach",
            "_type": "block",
            "children": [
              {
                "_key": "cs-outreach-l",
                "_type": "span",
                "marks": [
                  "strong"
                ],
                "text": "Parent & Family Outreach:"
              },
              {
                "_key": "cs-outreach-t",
                "_type": "span",
                "marks": [],
                "text": "Counselors host regular webinars and one-on-one conferences to equip families with strategies for supporting well-being at home."
              }
            ],
            "markDefs": [],
            "style": "normal"
          }
        ],
        "title": "Dedicated Counseling &\nSupport Services"
      },
      "image": {
        "_type": "picture",
        "alt": "SAIS - UAQ student smiling while working on a craft activity",
        "asset": {
          "_ref": "image-237c19c32fc0b1e8bc4a79cd3fd58b232c26bf3b-1600x1312-jpg",
