              {
                "_key": "wcam-1-l",
                "_type": "span",
                "marks": [
                  "strong"
                ],
                "text": "Healthy Lifestyle Week:"
              },
              {
                "_key": "wcam-1-t",
                "_type": "span",
                "marks": [],
                "text": "A dedicated week each term featuring myriad activities."
              }
            ],
            "markDefs": [],
            "style": "normal"
          },
          {
            "_key": "wcam-2",
            "_type": "block",
            "children": [
              {
                "_key": "wcam-2-l",
                "_type": "span",
                "marks": [
                  "strong"
                ],
                "text": "Annual Sports Day & Fitness Clubs:"
              },
              {
                "_key": "wcam-2-t",
                "_type": "span",
                "marks": [],
                "text": "From track relays to yoga and dance clubs, we promote daily physical activity as a cornerstone of mental and physical health."
              }
            ],
            "markDefs": [],
            "style": "normal"
          },
          {
            "_key": "wcam-3",
            "_type": "block",
            "children": [
              {
                "_key": "wcam-3-l",
                "_type": "span",
                "marks": [
                  "strong"
                ],
                "text": "Mental Health Awareness Days:"
              },
              {
                "_key": "wcam-3-t",
                "_type": "span",
                "marks": [],
                "text": "Quarterly events with guest speakers, stress-relief stations (e.g., art-therapy corners, relaxation tents), and student-led panels."
              }
            ],
            "markDefs": [],
            "style": "normal"
          }
        ],
        "title": "Campus-Wide Wellness Campaigns"
      },
