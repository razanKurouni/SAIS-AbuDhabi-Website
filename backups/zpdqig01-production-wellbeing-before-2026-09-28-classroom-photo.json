        "description": [
          {
            "_key": "wci-1",
            "_type": "block",
            "children": [
              {
                "_key": "wci-1-l",
                "_type": "span",
                "marks": [
                  "strong"
                ],
                "text": "Speaking Corner:"
              },
              {
                "_key": "wci-1-t",
                "_type": "span",
                "marks": [],
                "text": "Each section features a dedicated Speaking Corner (part of our SEL program) where students can share thoughts, practice communication skills, and seek peer or counselor support."
              }
            ],
            "markDefs": [],
            "style": "normal"
          },
          {
            "_key": "wci-2",
            "_type": "block",
            "children": [
              {
                "_key": "wci-2-l",
                "_type": "span",
                "marks": [
                  "strong"
                ],
                "text": "Collaborative Planning:"
              },
              {
                "_key": "wci-2-t",
                "_type": "span",
                "marks": [],
                "text": "Teachers and counselors co-design lesson plans that infuse academic topics with social-emotional check-points and opportunities for cooperative learning."
              }
            ],
            "markDefs": [],
            "style": "normal"
          },
          {
            "_key": "wci-3",
            "_type": "block",
            "children": [
              {
                "_key": "wci-3-l",
                "_type": "span",
                "marks": [
                  "strong"
                ],
                "text": "Feedback Loops:"
              },
              {
                "_key": "wci-3-t",
                "_type": "span",
                "marks": [],
                "text": "Regular surveys of students and staff inform ongoing refinements to our Well-Being Framework, ensuring it remains responsive to community needs."
              }
            ],
            "markDefs": [],
            "style": "normal"
          }
