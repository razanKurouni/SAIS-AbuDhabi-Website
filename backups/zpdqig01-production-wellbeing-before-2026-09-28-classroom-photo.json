      "slot": "counselingSupportSection"
    },
    {
      "_key": "selSection",
      "_type": "imageTextSection",
      "heading": {
        "_type": "sectionHeading",
        "description": [
          {
            "_key": "sel-p1",
            "_type": "block",
            "children": [
              {
                "_key": "sel-p1-s",
                "_type": "span",
                "marks": [],
                "text": "Curriculum Integration: Our SEL curriculum runs from Kindergarten through Grade 12, with age-appropriate competencies, self-awareness, self-management, social awareness, relationship skills, and responsible decision-making taught through homeroom lessons, art, and PE sessions."
              }
            ],
            "markDefs": [],
            "style": "normal"
          },
          {
            "_key": "sel-p2",
            "_type": "block",
            "children": [
              {
                "_key": "sel-p2-s",
                "_type": "span",
                "marks": [],
                "text": "SEL Coaches: Trained staff lead fortnightly classroom circles, role-play activities, and reflective journaling to help students practice empathy, resilience, and effective communication."
              }
            ],
            "markDefs": [],
            "style": "normal"
          }
        ],
        "title": "Social & Emotional Learning (SEL) Program"
      },
      "image": {
        "_type": "picture",
        "alt": "SAIS - UAQ teacher guiding two students through a hands-on SEL activity",
        "asset": {
          "_ref": "image-840d3240473f342d98ac6f3a26e713d4c2f8e3ff-2000x1662-jpg",
          "_type": "reference"
        }
      },
      "slot": "selSection"
    },
    {
      "_key": "wellbeingFramework",
      "_type": "imageTextSection",
      "heading": {
        "_type": "sectionHeading",
        "description": [
          {
            "_key": "wf-1",
            "_type": "block",
            "children": [
              {
                "_key": "wf-1-l",
                "_type": "span",
                "marks": [
                  "strong"
                ],
                "text": "Mindfulness & Restorative Practices:"
              },
              {
                "_key": "wf-1-t",
                "_type": "span",
                "marks": [],
                "text": "Daily “mindful minutes” and monthly restorative circles give students and teachers tools to regulate emotions and resolve conflicts constructively."
              }
            ],
            "markDefs": [],
            "style": "normal"
          },
          {
            "_key": "wf-2",
            "_type": "block",
            "children": [
              {
                "_key": "wf-2-l",
                "_type": "span",
                "marks": [
                  "strong"
                ],
                "text": "Professional Development:"
              },
              {
                "_key": "wf-2-t",
                "_type": "span",
                "marks": [],
                "text": "Faculty participate in ongoing workshops on SEL facilitation techniques, stress-management strategies, and inclusive classroom practices."
              }
            ],
            "markDefs": [],
            "style": "normal"
          },
          {
            "_key": "wf-3",
            "_type": "block",
            "children": [
              {
                "_key": "wf-3-l",
                "_type": "span",
                "marks": [
                  "strong"
                ],
                "text": "Peer-Support Networks:"
              },
              {
                "_key": "wf-3-t",
                "_type": "span",
                "marks": [],
                "text": "Student wellbeing ambassadors collaborate with counselors to organize “buddy check-ins” and peer-led wellness clubs."
              }
            ],
            "markDefs": [],
            "style": "normal"
          }
        ],
        "title": "Well-Being Framework & Approaches"
      },
      "image": {
        "_type": "image",
        "alt": "SAIS - UAQ students exploring classroom learning activities",
        "asset": {
          "_ref": "image-044968258c448c40cb34ae16d4c9a5164cf43024-1566x1312-jpg",
          "_type": "reference"
