      {
        "_key": "termsSection",
        "_type": "cardsSection",
        "cards": [
          {
            "_key": "payment-schedule",
            "_type": "card",
            "body": [
              {
                "_key": "b-0",
                "_type": "block",
                "children": [
                  {
                    "_key": "s-1",
                    "_type": "span",
                    "marks": [],
                    "text": "All tuition fees must be settled on or before the specified due dates as defined in the payment plan."
                  }
                ],
                "level": 1,
                "listItem": "number",
                "markDefs": [],
                "style": "normal"
              },
              {
                "_key": "b-2",
                "_type": "block",
                "children": [
                  {
                    "_key": "s-3",
                    "_type": "span",
                    "marks": [],
                    "text": "The registration fee is deducted from tuition fees upon enrollment."
                  }
                ],
                "level": 1,
                "listItem": "number",
                "markDefs": [],
                "style": "normal"
              },
              {
                "_key": "b-4",
                "_type": "block",
                "children": [
                  {
                    "_key": "s-5",
                    "_type": "span",
                    "marks": [],
                    "text": "An early payment discount is available for full payment made before the commencement of Term One."
                  }
                ],
                "level": 1,
                "listItem": "number",
                "markDefs": [],
                "style": "normal"
              },
              {
                "_key": "b-6",
                "_type": "block",
                "children": [
                  {
                    "_key": "s-7",
                    "_type": "span",
                    "marks": [],
                    "text": "For post-dated cheques (PDC), amounts will be considered paid only after successful clearance and credit to the school’s bank account."
                  }
                ],
                "level": 1,
                "listItem": "number",
                "markDefs": [],
                "style": "normal"
              },
              {
                "_key": "b-8",
                "_type": "block",
                "children": [
                  {
                    "_key": "s-9",
                    "_type": "span",
                    "marks": [],
                    "text": "A service charge of AED 500 will be applied for any cheques returned by the bank."
                  }
                ],
                "level": 1,
                "listItem": "number",
                "markDefs": [],
                "style": "normal"
              },
              {
                "_key": "b-a",
                "_type": "block",
                "children": [
                  {
                    "_key": "s-b",
                    "_type": "span",
                    "marks": [],
                    "text": "Parents/guardians will be billed for any damage to school property caused by their child."
                  }
                ],
                "level": 1,
                "listItem": "number",
                "markDefs": [],
                "style": "normal"
              },
              {
                "_key": "b-c",
                "_type": "block",
                "children": [
                  {
                    "_key": "s-d",
                    "_type": "span",
                    "marks": [],
                    "text": "The registration fee is non-refundable and non-transferable under all circumstances."
                  }
                ],
                "level": 1,
                "listItem": "number",
                "markDefs": [],
                "style": "normal"
              },
              {
                "_key": "b-e",
                "_type": "block",
                "children": [
                  {
                    "_key": "s-f",
                    "_type": "span",
                    "marks": [],
                    "text": "School books and uniforms are non-refundable items."
                  }
                ],
                "level": 1,
                "listItem": "number",
                "markDefs": [],
                "style": "normal"
              }
            ],
            "title": "Payment Schedule and Fees"
          },
          {
            "_key": "early-payment-discount",
            "_type": "card",
            "body": [
              {
                "_key": "b-g",
                "_type": "block",
                "children": [
                  {
                    "_key": "s-h",
                    "_type": "span",
                    "marks": [],
                    "text": "Parents or guardians who pay the full tuition fee for the upcoming academic year on or before August 20 will receive a 10% discount on the tuition portion of their fees. This is the only discount available under our policy."
                  }
                ],
                "markDefs": [],
                "style": "normal"
              }
            ],
            "title": "Early Payment Discount"
          }
        ],
        "heading": {
          "_type": "sectionHeading",
          "title": "Terms & Conditions"
        },
        "slot": "termsSection"
      },
      {
        "_key": "termsSection-rightColumn",
        "_type": "cardsSection",
        "cards": [
          {
            "_key": "refund-policy",
            "_type": "card",
            "body": [
              {
                "_key": "b-i",
                "_type": "block",
                "children": [
                  {
                    "_key": "s-j",
                    "_type": "span",
                    "marks": [],
                    "text": "Refunds are governed by the UAE Ministry of Education decree. Parents/guardians must submit a written withdrawal notice at least 30 days before the requested withdrawal date, along with a formal refund request."
                  }
                ],
                "markDefs": [],
                "style": "normal"
              },
              {
                "_key": "b-k",
                "_type": "block",
                "children": [
                  {
                    "_key": "s-l",
                    "_type": "span",
                    "marks": [
                      "strong"
                    ],
                    "text": "1.  Withdrawal Prior to the Academic Year Start"
                  }
                ],
                "markDefs": [],
                "style": "normal"
              },
              {
                "_key": "b-m",
                "_type": "block",
                "children": [
                  {
                    "_key": "s-n",
                    "_type": "span",
                    "marks": [],
                    "text": "Request Initiated by Parent/Guardian"
                  }
                ],
                "markDefs": [],
                "style": "normal"
              },
              {
                "_key": "b-o",
                "_type": "block",
                "children": [
                  {
                    "_key": "s-p",
                    "_type": "span",
                    "marks": [],
                    "text": "The balance of the Term 1 tuition fee (after deducting the Registration and Admissions Fees) will be refunded."
                  }
                ],
                "level": 1,
                "listItem": "bullet",
                "markDefs": [],
                "style": "normal"
              },
              {
                "_key": "b-q",
                "_type": "block",
                "children": [
                  {
                    "_key": "s-r",
                    "_type": "span",
                    "marks": [],
                    "text": "Registration and Admissions Fees are strictly non-refundable."
                  }
                ],
                "level": 1,
                "listItem": "bullet",
                "markDefs": [],
                "style": "normal"
              },
              {
                "_key": "b-s",
                "_type": "block",
                "children": [
                  {
                    "_key": "s-t",
                    "_type": "span",
                    "marks": [],
                    "text": "Request Initiated by the School"
                  }
                ],
                "markDefs": [],
                "style": "normal"
              },
              {
                "_key": "b-u",
                "_type": "block",
                "children": [
                  {
                    "_key": "s-v",
                    "_type": "span",
                    "marks": [],
                    "text": "The full amount of the Term 1 tuition fee will be refunded, except for the Registration Fee (which remains non-refundable)."
                  }
                ],
                "level": 1,
                "listItem": "bullet",
                "markDefs": [],
                "style": "normal"
              },
              {
                "_key": "b-w",
                "_type": "block",
                "children": [
                  {
                    "_key": "s-x",
                    "_type": "span",
                    "marks": [
                      "strong"
                    ],
                    "text": "2.  Withdrawal During the School Term"
                  }
                ],
                "markDefs": [],
                "style": "normal"
              },
              {
                "_key": "b-y",
                "_type": "block",
                "children": [
                  {
                    "_key": "s-z",
                    "_type": "span",
                    "marks": [],
                    "text": "If a student attends any portion of the first week of term or fails to attend entirely without providing at least one week’s written notice before term start, the school reserves the right to retain the Registration (or Re-registration) Fee in full."
                  }
                ],
                "level": 1,
                "listItem": "bullet",
                "markDefs": [],
                "style": "normal"
              },
              {
                "_key": "b-10",
                "_type": "block",
                "children": [
                  {
                    "_key": "s-11",
                    "_type": "span",
                    "marks": [],
                    "text": "If a student attends for two weeks or less during that term, the school may charge one full month’s tuition."
                  }
                ],
                "level": 1,
                "listItem": "bullet",
                "markDefs": [],
                "style": "normal"
              },
              {
                "_key": "b-12",
                "_type": "block",
                "children": [
                  {
                    "_key": "s-13",
                    "_type": "span",
                    "marks": [],
                    "text": "If a student attends for more than two weeks but less than one month in the term, the school may charge two full months’ tuition."
                  }
                ],
                "level": 1,
                "listItem": "bullet",
                "markDefs": [],
                "style": "normal"
              },
              {
                "_key": "b-14",
                "_type": "block",
                "children": [
                  {
                    "_key": "s-15",
                    "_type": "span",
                    "marks": [],
                    "text": "If a student attends for more than one month in the term, the school may charge the entire term’s tuition fee."
                  }
                ],
                "level": 1,
                "listItem": "bullet",
                "markDefs": [],
                "style": "normal"
              },
              {
                "_key": "b-16",
                "_type": "block",
                "children": [
