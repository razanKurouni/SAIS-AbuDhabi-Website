    {
      "_key": "cafeteriaSection",
      "_type": "imageTextSection",
      "heading": {
        "_type": "sectionHeading",
        "description": [
          {
            "_key": "fs-caf-intro",
            "_type": "block",
            "children": [
              {
                "_key": "fs-caf-intro-s",
                "_type": "span",
                "marks": [],
                "text": "Our canteen operates from two separate dining halls; one for boys and one for girls to ensure comfort and privacy for all students. Each hall provides:"
              }
            ],
            "markDefs": [],
            "style": "normal"
          },
          {
            "_key": "fs-caf-1",
            "_type": "block",
            "children": [
              {
                "_key": "fs-caf-1-l",
                "_type": "span",
                "marks": [
                  "strong"
                ],
                "text": "Nutritious, Balanced Meals"
              },
              {
                "_key": "fs-caf-1-t",
                "_type": "span",
                "marks": [],
                "text": "Carefully planned hot entrées featuring fresh fruits, vegetables, whole grains, and lean proteins. Menus rotate regularly to introduce variety and meet the dietary needs of different age groups."
              }
            ],
            "markDefs": [],
            "style": "normal"
          },
          {
            "_key": "fs-caf-2",
            "_type": "block",
            "children": [
              {
                "_key": "fs-caf-2-l",
                "_type": "span",
                "marks": [
                  "strong"
                ],
                "text": "Approved Light Snacks & Beverages"
              },
              {
                "_key": "fs-caf-2-t",
                "_type": "span",
                "marks": [],
                "text": "A selection of wholesome snacks and thirst-quenching drinks, all vetted against our strict nutrition guidelines."
              }
            ],
            "markDefs": [],
            "style": "normal"
          },
          {
            "_key": "fs-caf-3",
            "_type": "block",
            "children": [
              {
                "_key": "fs-caf-3-l",
                "_type": "span",
                "marks": [
                  "strong"
                ],
                "text": "Efficient Service During Breaks"
              },
              {
                "_key": "fs-caf-3-t",
                "_type": "span",
                "marks": [],
                "text": "Friendly, timely service during morning and afternoon breaks keeps students energized and ready to learn."
              }
            ],
            "markDefs": [],
            "style": "normal"
          }
