      {
        "_key": "growthSection",
        "_type": "imageTextSection",
        "heading": {
          "_type": "sectionHeading",
          "description": [
            {
              "_key": "home-growth-0",
              "_type": "block",
              "children": [
                {
                  "_key": "home-growth-0-span",
                  "_type": "span",
                  "marks": [],
                  "text": "We take great pride in its accomplished alumni, many of whom have been accepted into top-tier universities around the world and have gone on to become successful professionals, entrepreneurs, and leaders.\n"
                }
              ],
              "markDefs": [],
              "style": "normal"
            },
            {
              "_key": "d6ae796e98b4",
              "_type": "block",
              "children": [
                {
                  "_key": "home-growth-0-span",
                  "_type": "span",
                  "marks": [],
                  "text": "Its dedicated faculty comprises qualified and passionate educators committed to student growth, continuous professional development, and fostering a supportive and inclusive learning environment."
                }
              ],
              "markDefs": [],
              "style": "normal"
            },
            {
              "_key": "growth-together",
              "_type": "block",
              "children": [
                {
                  "_key": "growth-together-span",
                  "_type": "span",
                  "marks": [],
                  "text": "Together, the SAIS Abu Dhabi community works to empower students to become lifelong learners, responsible global citizens, and leaders of tomorrow."
                }
              ],
              "markDefs": [],
              "style": "normal"
            }
          ],
          "title": "SAIS Growth and Curriculum"
        },
