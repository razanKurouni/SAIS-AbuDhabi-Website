          "_key": "our-commitment",
          "_type": "card",
          "description": "Successful candidates will receive an excellent remuneration package including:",
          "entries": [
            {
              "_key": "our-commitment-0",
              "_type": "entry",
              "text": "Competitive tax-free salary"
            },
            {
              "_key": "our-commitment-1",
              "_type": "entry",
              "text": "Medical insurance"
            },
            {
              "_key": "our-commitment-2",
              "_type": "entry",
              "text": "UAE working permit"
            },
            {
              "_key": "our-commitment-3",
              "_type": "entry",
              "text": "Residence visa"
            },
            {
              "_key": "our-commitment-4",
              "_type": "entry",
              "text": "Annual flight allowance"
            },
            {
              "_key": "our-commitment-5",
              "_type": "entry",
              "text": "Tuition fee concession"
            },
            {
              "_key": "our-commitment-6",
              "_type": "entry",
              "text": "Additional benefits in accordance with UAE Labour Law"
            }
          ],
          "title": "Our Commitment"
        },
        {
          "_key": "qualifications",
          "_type": "card",
          "entries": [
            {
              "_key": "qualifications-0",
              "_type": "entry",
              "text": "Certified professional teaching qualification at degree level (B.Ed, PGCE, PGDE, or equivalent in Primary Education for KG and Primary positions)."
            },
            {
              "_key": "qualifications-1",
              "_type": "entry",
              "text": "Subject teachers must hold a Bachelor’s or Master’s degree in the relevant subject."
            },
            {
              "_key": "qualifications-2",
              "_type": "entry",
              "text": "Minimum of 2 years of varied and demonstrable teaching experience at various school levels."
            },
            {
              "_key": "qualifications-3",
              "_type": "entry",
              "text": "Experience in American curriculum schools is advantageous but not mandatory."
            },
            {
              "_key": "qualifications-4",
              "_type": "entry",
              "text": "Proven ability to motivate and inspire students."
            },
            {
              "_key": "qualifications-5",
              "_type": "entry",
              "text": "Commitment to providing outstanding teaching and learning."
            },
            {
              "_key": "qualifications-6",
              "_type": "entry",
              "text": "Desire to work in a challenging environment with genuine career advancement opportunities."
            }
          ],
          "title": "Qualifications & Requirements"
        }
