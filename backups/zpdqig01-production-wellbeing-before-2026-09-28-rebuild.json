            "_key": "sel-intro",
            "_type": "block",
            "children": [
              {
                "_key": "sel-intro-text",
                "_type": "span",
                "text": "The Social and Emotional Learning (SEL) program supports students in developing essential life skills that promote wellbeing, resilience, and positive relationships. Through structured activities and guided experiences, students build self-awareness, emotional regulation, responsible decision-making, and social skills, enabling them to thrive both academically and personally."
              }
            ],
            "style": "normal"
          }
        ],
