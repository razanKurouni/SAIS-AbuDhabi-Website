            "children": [
              {
                "_key": "wellbeing-framework-text",
                "_type": "span",
                "text": "At our school, wellbeing is promoted through daily practices and structured programs, including Social and Emotional Learning (SEL) sessions, counseling support, and wellbeing initiatives.\n\nTeachers integrate regular check-ins, positive reinforcement, and inclusive strategies within their classrooms, while the school engages parents and provides early intervention when needed to ensure every student feels supported, safe, and ready to succeed."
              }
            ],
            "style": "normal"
