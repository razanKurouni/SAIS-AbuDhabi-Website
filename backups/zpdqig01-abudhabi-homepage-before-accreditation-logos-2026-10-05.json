        }
      },
      "slot": "intro"
    },
    {
      "_key": "growthSection",
      "_type": "imageTextSection",
      "heading": {
        "_type": "sectionHeading",
        "description": [
          {
            "_key": "home-growth-0",
            "_type": "block",
            "children": [
              {
                "_key": "home-growth-0-span",
                "_type": "span",
                "marks": [],
                "text": "We take great pride in its accomplished alumni, many of whom have been accepted into top-tier universities around the world and have gone on to become successful professionals, entrepreneurs, and leaders."
              }
            ],
            "markDefs": [],
            "style": "normal"
          },
          {
            "_key": "d3a31c4ab850",
            "_type": "block",
            "children": [
              {
                "_key": "1cf52f69e7af",
                "_type": "span",
                "marks": [],
                "text": "Its dedicated faculty comprises qualified and passionate educators committed to student growth, continuous professional development, and fostering a supportive and inclusive learning environment."
              }
            ],
            "markDefs": [],
            "style": "normal"
          }
        ],
        "title": "SAIS Growth and Curriculum"
