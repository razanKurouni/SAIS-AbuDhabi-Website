  "sections": [
    {
      "_key": "engagementSection",
      "_type": "textSection",
      "body": [
        {
          "_key": "parent-involvement-engagement-body",
          "_type": "block",
          "children": [
            {
              "_key": "parent-involvement-engagement-body-span",
              "_type": "span",
              "text": "We foster a dynamic relationship between home and school, where parents are encouraged to participate in meaningful ways. From observing classroom lessons to joining school celebrations, and from volunteering in events to contributing through our active Parent-Teacher Association, PTA, our families are deeply engaged in the SAIS experience."
            }
          ]
        }
      ],
      "heading": {
        "_type": "sectionHeading",
        "description": [
          {
            "_key": "parent-involvement-engagement-intro",
            "_type": "block",
            "children": [
              {
                "_key": "parent-involvement-engagement-intro-span",
                "_type": "span",
                "text": "We believe that strong schools are built on strong partnerships with families. Parents are not just observers, they are active contributors to the school's life and culture. Their involvement plays a vital role in supporting student achievement, wellbeing, and a positive school climate."
              }
            ]
          }
        ],
        "title": "Engaging Families\nin Every Step of Learning"
      },
