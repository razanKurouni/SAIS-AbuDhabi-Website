    {
      "_key": "learningSliderSection",
      "_type": "cardsSection",
      "cards": [
        {
          "_key": "cat4-assessment",
          "_type": "card",
          "description": "The Cognitive Abilities Test (CAT4) helps us understand how students learn and their academic potential. Students in Grades 3-9 take this assessment upon enrollment to identify their learning styles, enabling teachers to:\n\n•\tAdapt teaching approaches and materials\n•\tAdjust instructional pace and emphasis\n•\tImplement differentiated instruction\n\nCAT4 measures four types of reasoning:\n\n•\tVerbal Reasoning - Understanding and reasoning through words\n•\tQuantitative Reasoning - Using numerical skills for problem-solving\n•\tNon-verbal Reasoning - Problem-solving using visual information\n•\tSpatial Ability - Thinking and drawing conclusions in three dimensions",
          "image": {
            "_type": "image",
            "alt": "SAIS - UAQ student during CAT4 assessment",
            "asset": {
              "_ref": "image-091776e79b07476623873069c764e70277197731-1528x1312-jpg",
              "_type": "reference"
            }
          },
          "title": "CAT4 Assessment"
        },
        {
          "_key": "nwea-map-testing",
          "_type": "card",
          "description": "Students in Grades 3-9 participate in MAP testing three times throughout the academic year. These computer-adaptive assessments:\n\n•\tProduce accurate data about each student’s learning level\n•\tIdentify areas of strength and opportunity\n•\tMeasure overall performance in core subjects",
          "image": {
            "_type": "image",
            "alt": "SAIS - UAQ students participating in MAP testing",
            "asset": {
              "_ref": "image-32ff2fa970a769ba53e2c285da047cfc25098c6d-1528x1312-jpg",
              "_type": "reference"
            }
          },
          "title": "NWEA MAP Testing"
        },
        {
          "_key": "ibt-arabic-testing",
          "_type": "card",
          "description": "To benchmark Arabic language proficiency against international standards, our students participate in IBT Arabic examinations conducted by ACER. This assessment provides valuable comparative data on student performance relative to peers in the region and worldwide.",
          "image": {
            "_type": "image",
            "alt": "SAIS - UAQ students reading during Arabic testing",
            "asset": {
              "_ref": "image-015b287ba416940c57fb413ceb2dda001f2f4c29-1528x1312-jpg",
              "_type": "reference"
            }
          },
          "title": "IBT Arabic Testing"
        },
        {
          "_key": "ngrt-testing",
          "_type": "card",
          "description": "The New Group Reading Test (NGRT) measures reading skills against national averages. This standardized assessment evaluates:\n\n•\tPhonics knowledge\n•\tReading comprehension\n•\tDecoding ability\n•\tVocabulary development\n•\tGrammatical understanding\n•\tDeduction and inference skills\n•\tUnderstanding of figurative and idiomatic language",
          "image": {
            "_type": "image",
            "alt": "SAIS - UAQ students reading during NGRT testing",
            "asset": {
              "_ref": "image-6dc25f40e9bbb6814516946eb93c2607d4d4dd1c-1528x1312-jpg",
              "_type": "reference"
            }
          },
          "title": "NGRT Testing"
        }
      ],
