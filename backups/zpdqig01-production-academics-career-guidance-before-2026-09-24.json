    {
      "_key": "curriculumOverviewSection-firstBlock",
      "_type": "imageTextSection",
      "heading": {
        "_type": "sectionHeading",
        "description": [
          {
            "_key": "overview-curriculum-1",
            "_type": "block",
            "children": [
              {
                "_key": "overview-curriculum-1-span",
                "_type": "span",
                "marks": [],
                "text": "We believe that exceptional education is built upon meaningful learning experiences that inspire students to think deeply, grow confidently, and engage purposefully with the world around them. Our curriculum is designed to be dynamic, student-centered, and future-focused, ensuring that every learner is challenged academically while also supported socially and emotionally. Through active learning, inquiry-based instruction, and authentic real-world connections, students develop the key skills necessary for lifelong success, including critical and creative thinking, communication and collaboration, and organization and self-management. We encourage students to become independent learners who can analyze, innovate, communicate effectively, and take ownership of their learning while building the confidence to navigate challenges and opportunities in an ever-changing global society."
              }
            ],
            "markDefs": [],
            "style": "normal"
          }
        ],
        "title": "Our Curriculum"
      },
