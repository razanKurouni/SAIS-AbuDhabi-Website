      "heading": {
        "_type": "sectionHeading",
        "description": [
          {
            "_key": "skills-intro",
            "_type": "block",
            "children": [
              {
                "_key": "skills-intro-span",
                "_type": "span",
                "marks": [],
                "text": "Our holistic approach nurtures each student’s intellectual, emotional, and social growth through programs that build leadership, resilience, empathy, and intercultural understanding. Whether preparing students for university admissions, careers in innovation, or civic engagement, the SAIS curriculum ensures they graduate as confident, well-rounded individuals ready to thrive in the 21st century.\n"
              }
            ],
            "markDefs": [],
            "style": "normal"
          }
        ],
        "title": "Skills and Dispositions"
      },
