  "sections": [
    {
      "_key": "curriculumSection",
      "_type": "entriesSection",
      "heading": {
        "_type": "sectionHeading",
        "description": [
          {
            "_key": "curriculum-overview",
            "_type": "block",
            "children": [
              {
                "_key": "curriculum-overview-span",
                "_type": "span",
                "marks": [],
                "text": "Our academic program is built upon a structured daily schedule that fosters active, student-centered learning and critical thinking, supported by differentiated instruction tailored to diverse needs."
              }
            ],
            "markDefs": [],
            "style": "normal"
          },
          {
            "_key": "82a81d1e66d2",
            "_type": "block",
            "children": [
              {
                "_key": "fe9e6a57fd79",
                "_type": "span",
                "marks": [],
                "text": "Our well-resourced library serves as a hub for research and literacy development, while hands-on STEM initiatives encourage innovation and problem-solving. Through our inclusive education framework, every learner receives the support necessary to thrive within the rigor of the American curriculum from kindergarten through grade 12."
              }
            ],
            "markDefs": [],
            "style": "normal"
          }
        ],
        "title": "Teaching and Learning "
      },
      "image": {
        "_type": "image",
        "alt": "SAIS - UAQ students learning with a microscope",
        "asset": {
          "_ref": "image-9c87593335ec4fb7f8cc9cffc8bcbffd6c53a7ee-1560x1312-jpg",
          "_type": "reference"
        }
      },
      "slot": "curriculumSection"
    },
    {
      "_key": "cultureSection",
      "_type": "imageTextSection",
      "heading": {
        "_type": "sectionHeading",
        "description": [
          {
            "_key": "culture-requirements",
            "_type": "block",
            "children": [
              {
                "_key": "culture-requirements-span",
                "_type": "span",
                "marks": [],
                "text": "Comprehensive career guidance and counseling services help students chart their academic and professional pathways, and our Acceptable Use and Devices policies ensure responsible, safe integration of technology in the classroom."
              }
            ],
            "markDefs": [],
            "style": "normal"
          },
          {
            "_key": "5277d1fa5296",
            "_type": "block",
            "children": [
              {
                "_key": "bd131f50c5f5",
                "_type": "span",
                "marks": [],
                "text": "Regular assessments including MAP, CAT4, and other benchmark tests, provide actionable insights into student progress, informing personalized instruction and upholding our commitment to academic excellence."
              }
            ],
            "markDefs": [],
            "style": "normal"
          }
        ],
        "title": "Guiding Every Step  of the Student Journey"
      },
      "image": {
        "_type": "image",
        "alt": "SAIS - UAQ students connecting with Emirati culture",
        "asset": {
          "_ref": "image-e819c8583ff02d94c97bded09bd58a1e2b8848f8-1528x1252-jpg",
          "_type": "reference"
        }
      },
      "slot": "cultureSection"
    },
    {
      "_key": "steamSection",
      "_type": "imageTextSection",
      "heading": {
        "_type": "sectionHeading",
        "description": [
          {
            "_key": "steam-integration",
            "_type": "block",
            "children": [
              {
                "_key": "steam-integration-span",
                "_type": "span",
                "marks": [],
                "text": "Each member in our highly qualified teaching staff holds advanced degrees, nationally or internationally recognized certifications, and extensive classroom experience. We invest continuously in their growth through a robust professional development program comprising subject-area workshops, instructional coaching, technology integration training, collaborative learning communities, data-driven seminars, accreditation workshops, and peer-observation cycles; so that every educator remains at the forefront of best practices in pedagogy, curriculum design, and student support."
              }
            ],
            "markDefs": [],
            "style": "normal"
          },
          {
            "_key": "fb5da4f2f9d8",
            "_type": "block",
            "children": [
              {
                "_key": "5fbcab98a760",
                "_type": "span",
                "marks": [],
                "text": "This sustained commitment to ongoing professional learning ensures that every classroom is led by a teacher prepared to meet the diverse needs of our students and maintain the highest standards of excellence."
              }
            ],
            "markDefs": [],
            "style": "normal"
          }
        ],
        "title": "STEAM Integration"
      },
