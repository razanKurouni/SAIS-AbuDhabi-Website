      {
        "_key": "selSection",
        "_type": "imageTextSection",
        "heading": {
          "_type": "sectionHeading",
          "description": [
            {
              "_key": "sel-p1",
              "_type": "block",
              "children": [
                {
                  "_key": "sel-p1-s",
                  "_type": "span",
                  "marks": [],
                  "text": "Curriculum Integration: Our SEL curriculum runs from Kindergarten through Grade 12, with age-appropriate competencies, self-awareness, self-management, social awareness, relationship skills, and responsible decision-making taught through homeroom lessons, art, and PE sessions."
                }
              ],
              "markDefs": [],
              "style": "normal"
            },
            {
              "_key": "sel-p2",
              "_type": "block",
              "children": [
                {
                  "_key": "sel-p2-s",
                  "_type": "span",
                  "marks": [],
                  "text": "SEL Coaches: Trained staff lead fortnightly classroom circles, role-play activities, and reflective journaling to help students practice empathy, resilience, and effective communication."
                }
              ],
              "markDefs": [],
              "style": "normal"
            }
          ],
          "title": "Social & Emotional Learning (SEL) Program"
        },
        "image": {
          "_type": "picture",
          "alt": "SAIS - Abu Dhabi teacher guiding two students through a hands-on SEL activity",
          "asset": {
            "_ref": "image-840d3240473f342d98ac6f3a26e713d4c2f8e3ff-2000x1662-jpg",
            "_type": "reference"
          }
        },
        "slot": "selSection"
      },
      {
