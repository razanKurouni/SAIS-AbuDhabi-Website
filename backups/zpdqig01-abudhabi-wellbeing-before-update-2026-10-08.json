    "sections": [
      {
        "_key": "commitment",
        "_type": "imageTextSection",
        "heading": {
          "_type": "sectionHeading",
          "description": [
            {
              "_key": "wc-lead",
              "_type": "block",
              "children": [
                {
                  "_key": "wc-lead-s",
                  "_type": "span",
                  "marks": [
                    "strong"
                  ],
                  "text": "At SAIS-Abu Dhabi ensuring the wellbeing of our entire community remains a cornerstone of our educational philosophy. This commitment has taken on even greater significance in challenging times. We are dedicated to supporting the academic, mental, social, emotional, and physical wellbeing of all students and staff members."
                }
              ],
              "markDefs": [],
              "style": "normal"
            }
          ],
          "title": "Our Commitment"
        },
        "image": {
          "_type": "image",
          "alt": "SAIS - Abu Dhabi students smiling in class",
          "asset": {
            "_ref": "image-43122afda509b36b356bd3ffd5efc18afb0ff1dd-3198x1454-jpg",
            "_type": "reference"
          }
        },
        "slot": "commitment"
      },
      {
        "_key": "counselingSupportSection",
        "_type": "imageTextSection",
        "heading": {
          "_type": "sectionHeading",
          "description": [
            {
              "_key": "cs-team",
              "_type": "block",
              "children": [
                {
                  "_key": "cs-team-l",
                  "_type": "span",
                  "marks": [
                    "strong"
                  ],
                  "text": "Licensed Counseling Team:"
                },
                {
                  "_key": "cs-team-t",
                  "_type": "span",
                  "marks": [],
                  "text": "We employ a full-time school counselor and assistant counselors who provide individual check-ins, small-group workshops, and crisis intervention as needed."
                }
              ],
              "markDefs": [],
              "style": "normal"
            },
            {
              "_key": "cs-open-door",
              "_type": "block",
              "children": [
                {
                  "_key": "cs-open-door-l",
                  "_type": "span",
                  "marks": [
                    "strong"
                  ],
                  "text": "Open-Door Policy:"
                },
                {
                  "_key": "cs-open-door-t",
                  "_type": "span",
                  "marks": [],
                  "text": "Every student and staff member may schedule drop-in sessions or refer peers, ensuring timely support for academic stress, interpersonal conflicts, or personal challenges."
                }
              ],
              "markDefs": [],
              "style": "normal"
            },
            {
              "_key": "cs-outreach",
              "_type": "block",
              "children": [
                {
                  "_key": "cs-outreach-l",
                  "_type": "span",
                  "marks": [
                    "strong"
                  ],
                  "text": "Parent & Family Outreach:"
                },
                {
                  "_key": "cs-outreach-t",
                  "_type": "span",
                  "marks": [],
                  "text": "Counselors host regular webinars and one-on-one conferences to equip families with strategies for supporting well-being at home."
                }
              ],
              "markDefs": [],
              "style": "normal"
            }
          ],
          "title": "Dedicated Counseling &\nSupport Services"
        },
        "image": {
          "_type": "picture",
