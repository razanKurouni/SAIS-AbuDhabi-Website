              "_type": "block",
              "children": [
                {
                  "_key": "wf-1-l",
                  "_type": "span",
                  "marks": [
                    "strong"
                  ],
                  "text": "Mindfulness & Restorative Practices:"
                },
                {
                  "_key": "wf-1-t",
                  "_type": "span",
                  "marks": [],
                  "text": "Daily “mindful minutes” and monthly restorative circles give students and teachers tools to regulate emotions and resolve conflicts constructively."
                }
              ],
              "markDefs": [],
              "style": "normal"
            },
            {
              "_key": "wf-2",
              "_type": "block",
              "children": [
                {
                  "_key": "wf-2-l",
                  "_type": "span",
                  "marks": [
                    "strong"
                  ],
                  "text": "Professional Development:"
                },
                {
                  "_key": "wf-2-t",
                  "_type": "span",
                  "marks": [],
                  "text": "Faculty participate in ongoing workshops on SEL facilitation techniques, stress-management strategies, and inclusive classroom practices."
                }
              ],
              "markDefs": [],
              "style": "normal"
            },
            {
              "_key": "wf-3",
              "_type": "block",
              "children": [
                {
                  "_key": "wf-3-l",
                  "_type": "span",
                  "marks": [
                    "strong"
                  ],
                  "text": "Peer-Support Networks:"
                },
                {
                  "_key": "wf-3-t",
                  "_type": "span",
                  "marks": [],
                  "text": "Student wellbeing ambassadors collaborate with counselors to organize “buddy check-ins” and peer-led wellness clubs."
                }
              ],
              "markDefs": [],
              "style": "normal"
            }
          ],
          "title": "Well-Being Framework & Approaches"
        },
