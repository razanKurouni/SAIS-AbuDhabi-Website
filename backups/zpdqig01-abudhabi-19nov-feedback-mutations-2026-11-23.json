    "ifRevisionID": "ZBLL2B0uZFDDTLIGrqXySM",
    "set": {
     "sections[_key==\"curriculumSection\"].heading.description[_key==\"acad-intro-0\"].children[_key==\"acad-intro-0-span\"].text": "We deliver a robust American curriculum built on the California Common Core State Standards. Our approach fosters academic excellence, innovation, and global citizenship through engaging, inclusive learning experiences grounded in UAE culture.",
     "sections[_key==\"teachingCommitmentsSection\"].cards[_key==\"rigorous-standards\"].title": "Uncompromising Academic\nStandards",
     "sections[_key==\"teachingCommitmentsSection\"].cards[_key==\"rigorous-standards\"].description": "The California Common Core State Standards provide a strong foundation in English Language Arts and Mathematics, emphasizing critical thinking, problem-solving, and real-world application. In Science, students learn through inquiry-based, hands-on investigation that prepares them to explore and address global challenges.",
