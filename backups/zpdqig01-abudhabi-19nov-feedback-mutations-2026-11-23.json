   "patch": {
    "id": "about-page",
    "ifRevisionID": "zabXJBmUBsslDGTfzxgOYT",
    "set": {
     "sections[_key==\"intro\"].body[_key==\"tuynxb9m\"].children[_key==\"o00htqb7\"].text": "SAIS - Abu Dhabi opened its doors in 2016, launching a purposeful and transformative educational mission. From day one, the school has been deeply committed to fostering academic excellence, innovation, and global citizenship in every student.",
     "sections[_key==\"ourStory\"].heading.title": "The journey of SAIS - Abu Dhabi began in 2016, marking the start of a purposeful and transformative educational mission. From its first day, the school has been deeply committed to fostering excellence, innovation, and a sense of global citizenship among its students.",
