  {
   "patch": {
    "id": "our-team-page",
    "ifRevisionID": "sHf47GHI0n0I18d08qSDyf",
    "set": {
     "sections[_key==\"leadershipSection\"].cards[_key==\"hanna-halabi\"].subtitle": "Assistant Vice Principal",
     "sections[_key==\"leadershipSection\"].cards[_key==\"fc333b8843c0\"].subtitle": "Head of Inclusion",
     "sections[_key==\"leadershipSection\"].cards[_key==\"fc333b8843c0\"].label": "19",
     "sections[_key==\"leadershipSection\"].cards[_key==\"fc333b8843c0\"].description": "As a member of the Senior Leadership Team at SAIS, I bring 19 years of experience in the UAE education sector and hold a Master’s degree in Special Educational Needs. Throughout my career, I have been committed to promoting inclusive education, student wellbeing, and academic success for all learners. I work collaboratively with students, families, educators, and school leaders to develop effective support systems and create learning environments where every student feels valued, supported, and empowered to achieve their full potential."
    }
   }
  },
  {
   "patch": {
