    {
      "_key": "termsSection",
      "_type": "cardsSection",
      "cards": [
        {
          "_key": "disclaimer",
          "_type": "card",
          "body": [
            {
              "_key": "disclaimer-text",
              "_type": "block",
              "children": [
                {
                  "_key": "disclaimer-text-span",
                  "_type": "span",
                  "text": "Please note that school fees for the upcoming academic year are subject to change in accordance with Article 51 of the Bylaw of Federal Law No. (28) of 1999 Concerning Private Education and applicable regulations."
                }
              ],
              "style": "normal"
            }
          ],
          "title": "Disclaimer"
        },
        {
          "_key": "payment-schedule",
          "_type": "card",
          "body": [
            {
              "_key": "schedule-1",
              "_type": "block",
              "children": [
                {
                  "_key": "schedule-1-span",
                  "_type": "span",
                  "text": "All tuition fees must be settled on or before the specified due dates as defined in the payment plan."
                }
              ],
              "level": 1,
              "listItem": "number",
              "style": "normal"
            },
            {
              "_key": "schedule-2",
              "_type": "block",
              "children": [
                {
                  "_key": "schedule-2-span",
                  "_type": "span",
                  "text": "The registration fee is deducted from tuition fees upon enrollment."
                }
              ],
              "level": 1,
              "listItem": "number",
              "style": "normal"
            },
            {
              "_key": "schedule-3",
              "_type": "block",
              "children": [
                {
                  "_key": "schedule-3-span",
                  "_type": "span",
                  "text": "An early payment discount is available for full payment made before the commencement of Term One."
                }
              ],
              "level": 1,
              "listItem": "number",
              "style": "normal"
            },
            {
              "_key": "schedule-4",
              "_type": "block",
              "children": [
                {
                  "_key": "schedule-4-span",
                  "_type": "span",
                  "text": "For post-dated cheques (PDC), amounts will be considered paid only after successful clearance and credit to the school’s bank account."
                }
              ],
              "level": 1,
              "listItem": "number",
              "style": "normal"
            },
            {
              "_key": "schedule-5",
              "_type": "block",
              "children": [
                {
                  "_key": "schedule-5-span",
                  "_type": "span",
                  "text": "A service charge of AED 500 will be applied for any cheques returned by the bank."
                }
              ],
              "level": 1,
              "listItem": "number",
              "style": "normal"
            },
            {
              "_key": "schedule-6",
              "_type": "block",
              "children": [
                {
                  "_key": "schedule-6-span",
                  "_type": "span",
                  "text": "Parents/guardians will be billed for any damage to school property caused by their child."
                }
              ],
              "level": 1,
              "listItem": "number",
              "style": "normal"
            },
            {
              "_key": "schedule-7",
              "_type": "block",
              "children": [
                {
                  "_key": "schedule-7-span",
                  "_type": "span",
                  "text": "The registration fee is non-refundable and non-transferable under all circumstances."
                }
              ],
              "level": 1,
              "listItem": "number",
              "style": "normal"
            },
            {
              "_key": "schedule-8",
              "_type": "block",
              "children": [
                {
                  "_key": "schedule-8-span",
                  "_type": "span",
                  "text": "School books and uniforms are non-refundable items."
                }
              ],
              "level": 1,
              "listItem": "number",
              "style": "normal"
            }
          ],
          "title": "Payment Schedule and Fees"
        },
        {
          "_key": "payment-methods",
          "_type": "card",
          "body": [
            {
              "_key": "method-1",
              "_type": "block",
              "children": [
                {
                  "_key": "method-1-span",
                  "_type": "span",
                  "text": "Cash"
                }
              ],
              "level": 1,
              "listItem": "number",
              "style": "normal"
            },
            {
              "_key": "method-2",
              "_type": "block",
              "children": [
                {
                  "_key": "method-2-span",
                  "_type": "span",
                  "text": "Current dated cheque"
                }
              ],
              "level": 1,
              "listItem": "number",
              "style": "normal"
            },
            {
              "_key": "method-3",
              "_type": "block",
              "children": [
                {
                  "_key": "method-3-span",
                  "_type": "span",
                  "text": "Post-dated cheques"
                }
              ],
              "level": 1,
              "listItem": "number",
              "style": "normal"
            },
            {
              "_key": "method-4",
              "_type": "block",
              "children": [
                {
                  "_key": "method-4-span",
                  "_type": "span",
                  "text": "Credit card (Visa or Mastercard)"
                }
              ],
              "level": 1,
              "listItem": "number",
              "style": "normal"
            },
            {
              "_key": "method-5",
              "_type": "block",
              "children": [
                {
                  "_key": "method-5-span",
                  "_type": "span",
                  "text": "Wire transfer"
                }
              ],
              "level": 1,
              "listItem": "number",
              "style": "normal"
            },
            {
              "_key": "payment-note",
              "_type": "block",
              "children": [
                {
                  "_key": "payment-note-span",
                  "_type": "span",
                  "marks": [
                    "strong"
                  ],
                  "text": "Please note:"
                }
              ],
              "style": "normal"
            },
            {
              "_key": "payment-note-1",
              "_type": "block",
              "children": [
                {
                  "_key": "payment-note-1-span",
                  "_type": "span",
                  "text": "Current dated or post-dated cheques will not be accepted for initial academic year payments unless submitted at least one month before the academic year commences."
                }
              ],
              "level": 1,
              "listItem": "bullet",
              "style": "normal"
            },
            {
              "_key": "payment-note-2",
              "_type": "block",
              "children": [
                {
                  "_key": "payment-note-2-span",
                  "_type": "span",
                  "text": "Fees are considered paid only when credited to the school’s bank account."
                }
              ],
              "level": 1,
              "listItem": "bullet",
              "style": "normal"
            },
            {
              "_key": "payment-note-3",
              "_type": "block",
              "children": [
                {
                  "_key": "payment-note-3-span",
                  "_type": "span",
                  "text": "A student’s registration is considered complete only after the first payment has been cleared, whether made in cash, by credit card, or wire transfer."
                }
              ],
              "level": 1,
              "listItem": "bullet",
              "style": "normal"
            },
            {
              "_key": "payment-note-4",
              "_type": "block",
              "children": [
                {
                  "_key": "payment-note-4-span",
                  "_type": "span",
                  "text": "For wire transfers, all associated bank charges must be covered by the parent/guardian. Only the net amount received in the school’s account will be credited against outstanding fees."
                }
              ],
              "level": 1,
              "listItem": "bullet",
              "style": "normal"
            }
          ],
          "title": "Payment Methods"
        }
      ],
      "heading": {
        "_type": "sectionHeading",
        "title": "Terms & Conditions"
      },
      "slot": "termsSection"
    },
    {
      "_key": "termsSection-rightColumn",
      "_type": "cardsSection",
      "cards": [
        {
          "_key": "non-payment",
          "_type": "card",
          "body": [
            {
              "_key": "non-payment-intro",
              "_type": "block",
              "children": [
                {
                  "_key": "non-payment-intro-span",
                  "_type": "span",
                  "text": "The school reserves the following rights regarding non-payment of fees:"
                }
              ],
              "style": "normal"
            },
            {
              "_key": "non-payment-1",
              "_type": "block",
              "children": [
                {
                  "_key": "non-payment-1-span",
                  "_type": "span",
                  "text": "To send payment reminders via email, written notices, phone calls, SMS, and parent portal notifications to parents/guardians with outstanding payments."
                }
              ],
              "level": 1,
              "listItem": "bullet",
              "style": "normal"
            },
            {
              "_key": "non-payment-2",
              "_type": "block",
              "children": [
                {
                  "_key": "non-payment-2-span",
                  "_type": "span",
                  "text": "To temporarily suspend students for up to three school days per term (consecutively or intermittently) after issuing three payment default notices."
                }
              ],
              "level": 1,
              "listItem": "bullet",
              "style": "normal"
            },
            {
              "_key": "non-payment-3",
              "_type": "block",
              "children": [
                {
                  "_key": "non-payment-3-span",
                  "_type": "span",
                  "text": "To withhold the provision of learning resources, participation in extra-curricular activities and field trips, and access to school ICT networks, library, laboratories, and other facilities."
                }
              ],
              "level": 1,
              "listItem": "bullet",
              "style": "normal"
            },
            {
              "_key": "non-payment-4",
              "_type": "block",
              "children": [
                {
                  "_key": "non-payment-4-span",
                  "_type": "span",
                  "text": "To withhold transfer certificates, grade reports, mark sheets, transcripts, and recommendation letters for any student with outstanding fees."
                }
              ],
              "level": 1,
              "listItem": "bullet",
              "style": "normal"
            },
            {
              "_key": "non-payment-5",
              "_type": "block",
              "children": [
                {
                  "_key": "non-payment-5-span",
                  "_type": "span",
                  "text": "To pursue appropriate legal action and/or inform relevant authorities to recover outstanding fees."
                }
              ],
              "level": 1,
              "listItem": "bullet",
              "style": "normal"
            },
            {
              "_key": "non-payment-6",
              "_type": "block",
              "children": [
                {
                  "_key": "non-payment-6-span",
                  "_type": "span",
                  "text": "To claim legal fees and associated costs incurred in the recovery of outstanding fees."
                }
              ],
              "level": 1,
              "listItem": "bullet",
              "style": "normal"
            }
          ],
          "title": "Consequences of Non-Payment"
        },
        {
          "_key": "refund-policy",
          "_type": "card",
          "body": [
            {
              "_key": "refund-intro",
              "_type": "block",
              "children": [
                {
                  "_key": "refund-intro-span",
                  "_type": "span",
                  "text": "In accordance with the Ministry of Education decree:"
                }
              ],
              "style": "normal"
            },
            {
              "_key": "refund-1",
              "_type": "block",
              "children": [
                {
                  "_key": "refund-1-span",
                  "_type": "span",
                  "text": "1. Parents/guardians must provide 30 days’ advance notice of student withdrawal and submit a formal refund request."
                }
              ],
              "style": "normal"
            },
            {
              "_key": "refund-2",
              "_type": "block",
              "children": [
                {
                  "_key": "refund-2-span",
                  "_type": "span",
                  "text": "2. Withdrawal prior to the commencement of the academic year:"
                }
              ],
              "style": "normal"
            },
            {
              "_key": "refund-2a",
              "_type": "block",
              "children": [
                {
                  "_key": "refund-2a-span",
                  "_type": "span",
                  "text": "If initiated by the parent/guardian: The balance of the first term fee paid will be refunded; registration and admission fees remain non-refundable."
                }
              ],
              "level": 1,
              "listItem": "bullet",
              "style": "normal"
            },
            {
              "_key": "refund-2b",
              "_type": "block",
              "children": [
                {
                  "_key": "refund-2b-span",
                  "_type": "span",
                  "text": "If initiated by the school: The amount corresponding to the first term fee paid is refunded, excluding the registration fee."
                }
              ],
              "level": 1,
              "listItem": "bullet",
              "style": "normal"
            },
            {
              "_key": "refund-3",
              "_type": "block",
              "children": [
                {
                  "_key": "refund-3-span",
                  "_type": "span",
                  "text": "3. Withdrawal during the school term:"
                }
              ],
              "style": "normal"
            },
            {
              "_key": "refund-3a",
              "_type": "block",
              "children": [
                {
                  "_key": "refund-3a-span",
                  "_type": "span",
                  "text": "If a student attends any part of the first week or fails to attend without written notification one week before term commencement: The school retains the full registration or re-registration fee."
                }
              ],
              "level": 1,
              "listItem": "bullet",
              "style": "normal"
            },
            {
              "_key": "refund-3b",
              "_type": "block",
              "children": [
                {
                  "_key": "refund-3b-span",
                  "_type": "span",
                  "text": "If a student attends two weeks or less in a term: The school will charge the equivalent of one full month of tuition fees."
                }
              ],
              "level": 1,
              "listItem": "bullet",
              "style": "normal"
            },
            {
              "_key": "refund-3c",
              "_type": "block",
              "children": [
                {
                  "_key": "refund-3c-span",
                  "_type": "span",
                  "text": "If a student attends more than two weeks but less than one month: The school will charge the equivalent of two full months of tuition fees."
                }
              ],
              "level": 1,
              "listItem": "bullet",
              "style": "normal"
            },
            {
              "_key": "refund-3d",
              "_type": "block",
              "children": [
                {
                  "_key": "refund-3d-span",
                  "_type": "span",
                  "text": "If a student attends more than one month in a term: The school will charge the full-term fee."
                }
              ],
              "level": 1,
              "listItem": "bullet",
              "style": "normal"
            },
            {
              "_key": "refund-3e",
              "_type": "block",
              "children": [
                {
                  "_key": "refund-3e-span",
                  "_type": "span",
                  "text": "One month’s fee is calculated as one-tenth of the total annual school fees."
                }
              ],
              "level": 1,
              "listItem": "bullet",
              "style": "normal"
            }
          ],
          "title": "Refund Policy for Student Withdrawals"
