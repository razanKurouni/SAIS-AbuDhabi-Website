      {
        "_key": "accreditations",
        "_type": "cardsSection",
        "body": [
          {
            "_key": "about-accred-0",
            "_type": "block",
            "children": [
              {
                "_key": "about-accred-0-span",
                "_type": "span",
                "marks": [],
                "text": "Our school is proud to be supported by a distinguished network of internationally recognized accreditations, certifications, and educational partnerships that reflect our commitment to academic excellence, innovation, student wellbeing, and continuous professional growth."
              }
            ],
