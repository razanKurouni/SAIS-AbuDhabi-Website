        "cards": [
          {
            "_key": "vision",
            "_type": "card",
            "description": "To be a leading American curriculum school group, recognized for academic excellence, innovation and strong values, preparing confident individuals who embody the UAE’s identity, contribute meaningfully to society, and thrive within an evolving global landscape.",
            "image": {
              "_type": "image",
              "alt": "SAIS - Abu Dhabi principal walking with students in a school corridor",
              "asset": {
                "_ref": "image-27bcc69e74f41c093e65cb50291d202deeb2c387-1552x814-png",
                "_type": "reference"
              }
            },
            "title": "Vision"
          },
          {
            "_key": "mission",
            "_type": "card",
            "description": "We will achieve our vision by combining academic excellence with meaningful real-world experiences, and personalized support. We will help every student discover their potential to succeed in higher education, future careers, and the communities they will shape.",
            "image": {
              "_type": "image",
              "alt": "SAIS - Abu Dhabi teacher helping two students in class",
              "asset": {
                "_ref": "image-c9f7dcd51c98b6af83d27b51b711e4bdc1c17cd3-1552x814-png",
