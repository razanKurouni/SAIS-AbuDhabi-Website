            "_type": "block",
            "children": [
              {
                "_key": "about-accred-2-span",
                "_type": "span",
                "marks": [],
                "text": "These partnerships strengthen our curriculum, enrich teaching and learning practices, and reinforce our mission to provide a well-rounded, internationally benchmarked education for every learner."
              }
            ],
            "markDefs": [],
            "style": "normal"
          }
