      {
        "_key": "adekSection",
        "_type": "imageTextSection",
        "heading": {
          "_type": "sectionHeading",
          "description": [
            {
              "_key": "about-adek-0",
              "_type": "block",
              "children": [
                {
                  "_key": "about-adek-0-span",
                  "_type": "span",
                  "marks": [],
                  "text": "The Abu Dhabi Department of Education and Knowledge (ADEK) is the regulatory authority responsible for overseeing and enhancing the quality of education across schools in Abu Dhabi. Through its comprehensive inspection framework, ADEK evaluates schools against key standards including student achievement, teaching and assessment, curriculum quality, student wellbeing, and leadership. We are proud to share that our school has been awarded a Very Good Rating in the 2024–2025 ADEK Irtiqaa inspection, reflecting our strong commitment to academic excellence, high-quality teaching and learning, student care, and continuous school improvement."
                }
              ],
              "markDefs": [],
              "style": "normal"
            }
          ],
          "title": "Department of Education and Knowledge (ADEK)"
        },
