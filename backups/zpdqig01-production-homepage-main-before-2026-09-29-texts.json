    {
      "_key": "whySection",
      "_type": "imageTextSection",
      "ctas": [
        {
          "_key": "see-more",
          "_type": "cta",
          "href": "/about-us",
          "label": "See More"
        }
      ],
      "heading": {
        "_type": "sectionHeading",
        "description": [
          {
            "_key": "why-0",
            "_type": "block",
            "children": [
              {
                "_key": "why-0-span",
                "_type": "span",
                "marks": [],
                "text": "At SAIS - UAQ, we provide more than just an education, we offer a transformative learning experience."
              }
            ],
            "markDefs": [],
            "style": "normal"
          },
          {
            "_key": "e2ee7f732067",
            "_type": "block",
            "children": [
              {
                "_key": "3674a9bd7406",
                "_type": "span",
                "marks": [],
                "text": "Rooted in a culture of excellence, our school empowers students to grow intellectually, emotionally, and socially within a safe, inclusive environment."
              }
            ],
            "markDefs": [],
            "style": "normal"
          },
          {
            "_key": "7308077213b3",
            "_type": "block",
            "children": [
              {
                "_key": "ce20356609fa",
                "_type": "span",
                "marks": [],
                "text": "Our American curriculum is thoughtfully aligned with global standards such as AERO and NGSS, while also embracing local heritage through Arabic Language, Islamic Studies, and UAE Social Studies. This distinctive combination ensures our students are globally aware and deeply connected to their cultural identity."
              }
            ],
            "markDefs": [],
            "style": "normal"
          }
        ],
        "title": "Why SAIS"
      },
      "image": {
        "_type": "image",
        "alt": "SAIS - UAQ teacher helping a student",
        "asset": {
          "_ref": "image-24583968d5582fd95370f0da3810f7732d03adf6-2360x1530-png",
          "_type": "reference"
        }
      },
      "slot": "whySection"
    },
    {
      "_key": "whyFeature",
      "_type": "imageTextSection",
      "heading": {
        "_type": "sectionHeading",
        "description": [
          {
            "_key": "hr5dnh1u",
            "_type": "block",
            "children": [
              {
                "_key": "twyf6bkv",
                "_type": "span",
                "marks": [],
                "text": "We are to be recognized for its holistic approach to education, balancing academic rigor with a warm, supportive atmosphere that prioritizes student well-being."
              }
            ],
            "markDefs": [],
            "style": "normal"
          },
          {
            "_key": "0jx91zd0",
            "_type": "block",
            "children": [
              {
                "_key": "o4sz1y7k",
                "_type": "span",
                "marks": [],
                "text": "Recently, we were honored to be featured in Asia Education Review as one of the Top 10 International Schools in the UAE, applauded for our multicultural environment, innovative teaching methods, and unwavering focus on both academic excellence and emotional support."
              }
            ],
            "markDefs": [],
            "style": "normal"
          }
        ]
      },
      "image": {
        "_type": "image",
