  "route": "/",
  "sections": [
    {
      "_key": "intro",
      "_type": "imageTextSection",
      "heading": {
        "_type": "sectionHeading",
        "description": [
          {
            "_key": "918af2a602ea",
            "_type": "block",
            "children": [
              {
                "_key": "c07b638746fa",
                "_type": "span",
                "marks": [],
                "text": "Sharjah American International School (SAIS) is a dynamic network of four purpose-built campuses (Sharjah, Dubai, Umm Al Quwain, and Abu Dhabi) united by a single mission: to deliver a rigorous American-style curriculum while celebrating local heritage and fostering global citizenship."
              }
            ],
            "markDefs": [],
            "style": "normal"
          },
          {
            "_key": "6d3c08f31fa0",
            "_type": "block",
            "children": [
              {
                "_key": "77c5bd8ade8b",
                "_type": "span",
                "marks": [],
                "text": "Founded and inspired by the vision of Dr. Aysha Sayyar and Dr. Nawaf Fawaz, SAIS nurtures learners from Kindergarten through Grade 12, guiding them to excel academically, think critically, and act with integrity and compassion."
              }
            ],
            "markDefs": [],
            "style": "normal"
          }
        ],
        "title": "Rooted in Excellence. Driven by Purpose. Inspired by the Future."
      },
      "image": {
        "_type": "image",
        "alt": "SAIS - Umm Al Quwain Campus",
        "asset": {
          "_ref": "image-f66d9f19f3e1706473120a1bb60d3b62a73ae285-1560x1312-jpg",
          "_type": "reference"
        }
      },
      "slot": "intro"
    },
    {
      "_key": "growthSection",
      "_type": "imageTextSection",
      "heading": {
        "_type": "sectionHeading",
        "description": [
          {
            "_key": "944800536c8a",
            "_type": "block",
            "children": [
              {
                "_key": "0e19b3be596d",
                "_type": "span",
                "marks": [],
                "text": "As one of the distinguished campuses, SAIS - UAQ brings the SAIS ethos to life in a warm, inclusive environment. Here, students benefit from experienced educators, modern learning technologies, and a broad program of arts, athletics, and service learning."
              }
            ],
            "markDefs": [],
            "style": "normal"
          },
          {
            "_key": "90babbd91fa5",
            "_type": "block",
            "children": [
              {
                "_key": "bf153ee56354",
                "_type": "span",
                "marks": [],
                "text": "From early literacy foundations to advanced coursework in the upper grades, SAIS - UAQ prepares every student to become a confident, creative problem-solver and an engaged leader, equipped to thrive in higher education and contribute positively to its community."
              }
            ],
            "markDefs": [],
            "style": "normal"
          }
        ],
        "title": "SAIS Growth and Curriculum"
      },
      "image": {
        "_type": "image",
