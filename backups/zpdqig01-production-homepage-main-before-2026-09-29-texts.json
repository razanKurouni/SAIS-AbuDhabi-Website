  "hero": {
    "heading": {
      "_type": "sectionHeading",
      "subtitle": "American Curriculum, UAE Heart A leading American curriculum school group, recognized for academic excellence, innovation and strong values.",
      "title": "Empowering Students to Achieve Their Highest Potential"
    },
    "image": {
      "_type": "image",
      "alt": "SAIS - Umm Al Quwain students gathered on campus",
      "asset": {
        "_ref": "image-7e307d0d5c68e054fa7681965af53ee3faaab341-3840x2144-jpg",
