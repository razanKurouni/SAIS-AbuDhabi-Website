        "_type": "sectionHeading",
        "description": [
          {
            "_key": "sp-lead",
            "_type": "block",
            "children": [
              {
                "_key": "sp-lead-s",
                "_type": "span",
                "marks": [
                  "strong"
                ],
                "text": "Our school policies are carefully developed in alignment with ADEK requirements to ensure the highest standards of safety, wellbeing, and operational excellence for both students and staff. They provide a clear framework that guides our daily practice, supports a positive and inclusive school culture, and ensures consistency across all areas of school life. These policies reflect our commitment to safeguarding, accountability, and continuous improvement, while promoting a secure and supportive environment where every member of the school community can thrive."
              }
            ],
            "markDefs": [],
            "style": "normal"
          }
        ],
        "title": "A Safe and Supportive Environment"
      },
      "slot": "intro"
    },
