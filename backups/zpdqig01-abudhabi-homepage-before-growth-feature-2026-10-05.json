      "heading": {
        "_type": "sectionHeading",
        "description": [
          {
            "_key": "home-why-0",
            "_type": "block",
            "children": [
              {
                "_key": "home-why-0-span",
                "_type": "span",
                "marks": [],
                "text": "The campus is recognized for its inclusive approach to education, strong community partnerships, and growing parent trust. Active engagement with families and stakeholders contributes to a positive learning environment and a strong reputation within the community."
              }
            ],
            "markDefs": [],
            "style": "normal"
          }
        ],
        "title": "Why SAIS"
      },
      "image": {
        "_type": "image",
        "alt": "SAIS - Abu Dhabi teacher helping a student",
        "asset": {
          "_ref": "image-24583968d5582fd95370f0da3810f7732d03adf6-2360x1530-png",
