    {
      "_key": "whyFeature",
      "_type": "imageTextSection",
      "heading": {
        "_type": "sectionHeading",
        "description": [
          {
            "_key": "home-why-feature-0",
            "_type": "block",
            "children": [
              {
                "_key": "home-why-feature-0-span",
                "_type": "span",
                "marks": [],
                "text": "SAIS - Abu Dhabi is Cognia accredited with distinction, placing it within the organization's highest tier of recognized schools. It has also been recognized among the Top 10 International Schools in the UAE and has demonstrated consistently strong performance in international assessments."
              }
            ],
            "markDefs": [],
            "style": "normal"
          },
          {
            "_key": "home-why-feature-1",
            "_type": "block",
            "children": [
              {
                "_key": "home-why-feature-1-span",
                "_type": "span",
                "marks": [],
                "text": "Students have achieved outstanding results across academics, leadership, literacy, sustainability, and sport. Highlights include exceptional TIMSS performance, a 100% AP examination pass rate, strong MAP assessment outcomes, participation in Model United Nations, debates, public speaking, reading competitions, the University of Oxford Story Writing Competition, and environmental initiatives. Students have also earned recognition across numerous sports."
              }
            ],
            "markDefs": [],
            "style": "normal"
          }
        ]
      },
