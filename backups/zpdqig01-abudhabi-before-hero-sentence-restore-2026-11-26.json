      {
        "_key": "whySection",
        "_type": "imageTextSection",
        "heading": {
          "_type": "sectionHeading",
          "description": [
            {
              "_key": "home-why-0",
              "_type": "block",
              "children": [
                {
                  "_key": "home-why-0-span",
                  "_type": "span",
                  "marks": [],
                  "text": "At SAIS - Abu Dhabi, we believe that education is more than academics; it’s about nurturing confident, capable, and compassionate individuals who are ready to thrive in a rapidly changing world."
                }
              ],
              "markDefs": [],
              "style": "normal"
            },
            {
              "_key": "85f4684d8b31",
              "_type": "block",
              "children": [
                {
                  "_key": "cbaafe201cb7",
                  "_type": "span",
                  "marks": [],
                  "text": "Our journey began in 2016, and in a short time, we have become one of the most respected American-curriculum schools in the region. Backed by the legacy of the Sharjah American International School (established in 1997), our Abu Dhabi campus reflects a rich tradition of academic excellence, innovation, and strong values."
                }
              ],
              "markDefs": [],
              "style": "normal"
            }
          ],
          "title": "Why SAIS - Abu Dhabi?"
        },
