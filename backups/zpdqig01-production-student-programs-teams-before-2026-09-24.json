  "sections": [
    {
      "_key": "excellenceIntro",
      "_type": "textSection",
      "heading": {
        "_type": "sectionHeading",
        "description": [
          {
            "_key": "sp-intro",
            "_type": "block",
            "children": [
              {
                "_key": "sp-intro-s",
                "_type": "span",
                "marks": [],
                "text": "Our Student Programs are designed to enrich the educational experience beyond the classroom. Through a variety of opportunities, students are encouraged to develop their talents, discover new interests, build meaningful relationships, and become active contributors to the school community."
              }
            ],
            "markDefs": [],
            "style": "normal"
          }
        ],
        "title": "Inspiring Growth, Leadership, and\nStudent Engagement"
      },
      "slot": "excellenceIntro"
    },
    {
      "_key": "highlightsSection",
      "_type": "imageTextSection",
      "heading": {
        "_type": "sectionHeading",
        "description": [
          {
            "_key": "sp-lead-1",
            "_type": "block",
            "children": [
              {
                "_key": "sp-lead-1-s",
                "_type": "span",
                "marks": [],
                "text": "Our programs support the holistic development of students by fostering leadership, responsibility, collaboration, creativity, and personal growth. Whether participating in leadership initiatives, community engagement activities, student-led projects, or future enrichment opportunities, students gain valuable experiences that help prepare them for success in school and beyond."
              }
            ],
            "markDefs": [],
            "style": "normal"
          },
          {
            "_key": "sp-lead-2",
            "_type": "block",
            "children": [
              {
                "_key": "sp-lead-2-s",
                "_type": "span",
                "marks": [],
                "text": "We are committed to providing engaging and purposeful programs that empower students to grow as confident learners, responsible citizens, and future leaders in an ever-changing world."
              }
            ],
            "markDefs": [],
            "style": "normal"
          }
        ],
        "title": "Student Leadership Program"
      },
      "image": {
        "_type": "image",
        "alt": "SAIS - UAQ student presenting the Student Government activities report to classmates",
        "asset": {
          "_ref": "image-70f5b97a924389ad382328ff7fb7acaecc2f18ba-1600x1375-jpg",
          "_type": "reference"
        }
      },
      "slot": "highlightsSection"
    },
    {
      "_key": "potentialIntro",
      "_type": "textSection",
      "heading": {
        "_type": "sectionHeading",
        "description": [
          {
            "_key": "sp-pot-intro",
            "_type": "block",
            "children": [
              {
                "_key": "sp-pot-intro-s",
                "_type": "span",
                "marks": [],
                "text": "By embedding student leadership throughout our systems (from morning briefings to policy discussions) we foster an environment where young voices shape the campus experience and develop the confidence to lead beyond the classroom"
              }
            ],
            "markDefs": [],
            "style": "normal"
          }
        ],
        "title": "Helping Students to Discover\nand Maximize Their Potential"
      },
      "slot": "potentialIntro"
    },
