            ],
            "markDefs": [],
            "style": "normal"
          },
          {
            "_key": "b-4",
            "_type": "block",
            "children": [
              {
                "_key": "s-5",
                "_type": "span",
                "marks": [],
                "text": "To serve as the voice of the student body at SAIS - UAQ, actively shaping school policies and events to reflect the interests and goals of all learners."
              }
            ],
            "markDefs": [],
            "style": "normal"
          },
          {
            "_key": "b-6",
            "_type": "block",
            "children": [
              {
                "_key": "s-7",
                "_type": "span",
                "marks": [
                  "strong"
                ],
                "text": "Vision"
              }
            ],
            "markDefs": [],
            "style": "normal"
          },
          {
            "_key": "b-8",
            "_type": "block",
            "children": [
              {
                "_key": "s-9",
                "_type": "span",
                "marks": [],
                "text": "A vibrant and responsible student leadership team driven by integrity, creativity, and service, where every student is empowered to make a meaningful impact."
              }
            ],
            "markDefs": [],
            "style": "normal"
          }
        ],
        "title": "Student Government Association (SGA)"
